 drivers/media/pci/intel/ipu-isys-video.c      |   1 +
 drivers/media/pci/intel/ipu-isys.c            | 102 ++++++++++++---
 drivers/media/pci/intel/ipu4/ipu4-isys.c      | 121 +++++++++++++++---
 .../media/pci/intel/ipu4/ipu4p-isys-csi2.c    |  59 ++++++++-
 5 files changed, 273 insertions(+), 40 deletions(-)

