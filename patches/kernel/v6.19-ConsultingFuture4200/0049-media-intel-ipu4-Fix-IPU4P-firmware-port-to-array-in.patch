@@ -105,14 +146,14 @@ isys_complete_ext_device_registration(struct ipu_isys *isys,
 	}
 
 	rval = media_create_pad_link(&sd->entity, i,
-				     &isys->csi2[csi2->port].asd.sd.entity,
