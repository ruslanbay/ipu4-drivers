Subject: [PATCH 10/10] [WIP] media: ipu6: Add ipu4p csi phy driver

---
 drivers/media/pci/intel/ipu6/Makefile         |  1 +
 .../media/pci/intel/ipu6/ipu4p-isys-csi-phy.c | 74 +++++++++++++++++++
 .../pci/intel/ipu6/ipu4p-isys-csi2-regs.h     |  4 +
 drivers/media/pci/intel/ipu6/ipu6-isys.c      |  3 +
 drivers/media/pci/intel/ipu6/ipu6-isys.h      |  6 ++
 .../intel/ipu6/ipu6-platform-buttress-regs.h  | 15 ++++
 6 files changed, 103 insertions(+)
 create mode 100644 drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c

diff --git a/drivers/media/pci/intel/ipu6/Makefile b/drivers/media/pci/intel/ipu6/Makefile
index 54b543ec5..43bc57ff1 100644
--- a/drivers/media/pci/intel/ipu6/Makefile
+++ b/drivers/media/pci/intel/ipu6/Makefile
@@ -25,6 +25,7 @@ intel-ipu6-isys-y		:= ipu6-isys.o \
 				ipu6-isys-mcd-phy.o \
 				ipu6-isys-jsl-phy.o \
 				ipu6-isys-dwc-phy.o \
+				ipu4p-isys-csi-phy.o \
 				ipu7-isys-csi-phy.o
 
 obj-$(CONFIG_VIDEO_INTEL_IPU6)	+= intel-ipu6-isys.o
diff --git a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c
new file mode 100644
index 000000000..0f002a3f9
--- /dev/null
+++ b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (C) 2026 Intel Corporation */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+
+#include "ipu6.h"
+#include "ipu6-isys.h"
+#include "ipu6-platform-buttress-regs.h"
+#include "ipu4p-isys-csi2-regs.h"
+
+struct ipu4p_phy_bb_config {
+	u8 bb;
+	u8 crc;
+	u8 drc;
+	u8 afe;
+};
+
+static const struct ipu4p_phy_bb_config ipu4p_phy_bb_configs[] = {
+	{ 4, 13, 32, 0x0f },
+	{ 6, 13, 32, 0x15 },
+	{ 12, 13, 32, 0x0f },
+	{ 14, 13, 32, 0x15 },
+};
+
+static void ipu4p_isys_configure_phy_bb(struct ipu6_device *isp,
+					const struct ipu4p_phy_bb_config *config)
+{
+	void __iomem *base = isp->base;
+	u32 value;
+
+	value = readl(base + IPU4P_BUTTRESS_REG_CPHYX_DLL_OVRD(config->bb));
+	value &= ~GENMASK(6, 1);
+	value |= FIELD_PREP(GENMASK(6, 1), config->crc) | BIT(0);
+	writel(value, base + IPU4P_BUTTRESS_REG_CPHYX_DLL_OVRD(config->bb));
+
+	value = readl(base + IPU4P_BUTTRESS_REG_DPHYX_DLL_OVRD(config->bb));
+	value &= ~GENMASK(6, 1);
+	value |= FIELD_PREP(GENMASK(6, 1), config->drc) | BIT(0);
+	writel(value, base + IPU4P_BUTTRESS_REG_DPHYX_DLL_OVRD(config->bb));
+
+	value = config->afe | FIELD_PREP(GENMASK(30, 29), 2);
+	writel(value, base + IPU4P_BUTTRESS_REG_BBX_AFE_CONFIG(config->bb));
+}
+
+void ipu4p_isys_phy_setup(struct ipu6_isys *isys)
+{
+	struct ipu6_device *isp = isys->adev->isp;
+	void __iomem *isys_base = isys->pdata->base;
+	u32 bscan_exclude = (0x100 << 1) | (0x100 << 10) | (0x100 << 19);
+
+	writel(0x3895, isys_base + IPU4P_ISYS_GPOFFSET +
+	       IPU4P_CSI2_GPREG_CR_PORT_CONFIG);
+	writel(0x3895, isys_base + IPU4P_ISYS_COMBO_GPOFFSET +
+	       IPU4P_CSI2_GPREG_CR_PORT_CONFIG);
+	writel(bscan_exclude, isp->base + IPU4P_BUTTRESS_REG_CSI_BSCAN_EXCLUDE);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(ipu4p_phy_bb_configs); i++)
+		ipu4p_isys_configure_phy_bb(isp, &ipu4p_phy_bb_configs[i]);
+}
+
+/* IPU4P PHY building blocks remain configured until the ISYS power cycle. */
+int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
+			     struct ipu6_isys_csi2_config *cfg,
+			     const struct ipu6_isys_csi2_timing *timing,
+			     bool on)
+{
+	if (cfg->port >= isys->pdata->ipdata->csi2.nports)
+		return -EINVAL;
+
+	return 0;
+}
\ No newline at end of file
diff --git a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
index a0ff47df2..6256a048f 100644
--- a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
+++ b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi2-regs.h
@@ -48,6 +48,10 @@
 #define IPU4P_ISYS_CSI_ERROR_MASK			GENMASK(15, 0)
 #define IPU4P_ISYS_CSI_ERROR_BITS			16U
 
+/* IPU4P ISYS GPREG windows */
+#define IPU4P_ISYS_GPOFFSET				0x66800
+#define IPU4P_ISYS_COMBO_GPOFFSET			0x6e800
+
 /* CSI receiver registers */
 #define IPU4P_CSI2_RX_ENABLE				0x00
 #define IPU4P_CSI2_RX_ENABLE_ENABLE			BIT(0)
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.c b/drivers/media/pci/intel/ipu6/ipu6-isys.c
index 2cee2e22c..648681893 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.c
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.c
@@ -866,6 +866,7 @@ static int isys_runtime_pm_resume(struct device *dev)
 		ipu7_isys_setup_hw(isys);
 	} else if (IS_IPU4P(isp)) {
 		ipu4p_isys_irq_setup(isys);
+		ipu4p_isys_phy_setup(isys);
 	} else {
 		ipu6_isys_setup_hw(isys);
 		set_iwake_ltrdid(isys, 0, 0, LTR_ISYS_ON);
@@ -1099,6 +1100,8 @@ static int isys_probe(struct auxiliary_device *auxdev,
 		isys->phy_set_power = ipu6_isys_jsl_phy_set_power;
 	else if (IS_IPU6EP_MTL(adev->isp))
 		isys->phy_set_power = ipu6_isys_dwc_phy_set_power;
+	else if (IS_IPU4P(adev->isp))
+		isys->phy_set_power = ipu4p_isys_phy_set_power;
 	else
 		isys->phy_set_power = ipu6_isys_mcd_phy_set_power;
 
diff --git a/drivers/media/pci/intel/ipu6/ipu6-isys.h b/drivers/media/pci/intel/ipu6/ipu6-isys.h
index 9383cbefa..b62e6ed47 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-isys.h
+++ b/drivers/media/pci/intel/ipu6/ipu6-isys.h
@@ -254,4 +254,10 @@ int ipu6_isys_jsl_phy_set_power(struct ipu6_isys *isys,
 				struct ipu6_isys_csi2_config *cfg,
 				const struct ipu6_isys_csi2_timing *timing,
 				bool on);
+
+int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
+			     struct ipu6_isys_csi2_config *cfg,
+			     const struct ipu6_isys_csi2_timing *timing,
+			     bool on);
+void ipu4p_isys_phy_setup(struct ipu6_isys *isys);
 #endif /* IPU6_ISYS_H */
diff --git a/drivers/media/pci/intel/ipu6/ipu6-platform-buttress-regs.h b/drivers/media/pci/intel/ipu6/ipu6-platform-buttress-regs.h
index 1455582e6..18ec5f1b9 100644
--- a/drivers/media/pci/intel/ipu6/ipu6-platform-buttress-regs.h
+++ b/drivers/media/pci/intel/ipu6/ipu6-platform-buttress-regs.h
@@ -6,6 +6,21 @@
 
 #include <linux/bits.h>
 
+/* IPU4P CSI PHY building-block registers */
+#define IPU4P_BUTTRESS_REG_CSI_BSCAN_EXCLUDE		0x100d8
+#define IPU4P_BUTTRESS_REG_CPHY0_DLL_OVRD		0x10100
+#define IPU4P_BUTTRESS_REG_CPHY0_RX_CONTROL1		0x10110
+#define IPU4P_BUTTRESS_REG_DPHY0_DLL_OVRD		0x1014c
+#define IPU4P_BUTTRESS_REG_BB0_AFE_CONFIG		0x10174
+#define IPU4P_BUTTRESS_REG_CPHYX_DLL_OVRD(bb)		\
+	(IPU4P_BUTTRESS_REG_CPHY0_DLL_OVRD + ((bb) >> 1) * 0x100)
+#define IPU4P_BUTTRESS_REG_CPHYX_RX_CONTROL1(bb)	\
+	(IPU4P_BUTTRESS_REG_CPHY0_RX_CONTROL1 + ((bb) >> 1) * 0x100)
+#define IPU4P_BUTTRESS_REG_DPHYX_DLL_OVRD(bb)		\
+	(IPU4P_BUTTRESS_REG_DPHY0_DLL_OVRD + ((bb) >> 1) * 0x100)
+#define IPU4P_BUTTRESS_REG_BBX_AFE_CONFIG(bb)		\
+	(IPU4P_BUTTRESS_REG_BB0_AFE_CONFIG + ((bb) >> 1) * 0x100)
+
 /* IS_WORKPOINT_REQ */
 #define IPU6_BUTTRESS_REG_IS_FREQ_CTL		0x34
 /* PS_WORKPOINT_REQ */
