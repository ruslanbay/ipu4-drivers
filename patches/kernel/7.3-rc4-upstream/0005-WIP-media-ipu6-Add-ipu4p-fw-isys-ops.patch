--- /dev/null
+++ b/drivers/media/pci/intel/ipu6/ipu4p-fw-isys.c
@@ -0,0 +1,428 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (C) 2026 Intel Corporation */
+
+#include <linux/cacheflush.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include "ipu6-bus.h"
+#include "ipu6-dma.h"
+#include "ipu6-fw-com.h"
+#include "ipu6-isys-csi2.h"
+#include "ipu6-isys-queue.h"
+#include "ipu6-isys.h"
+#include "ipu6-platform-regs.h"
+#include "ipu4p-fw-isys.h"
+
+static void ipu4p_start_sp(struct ipu6_bus_device *adev)
+{
+	struct ipu6_isys *isys = ipu6_bus_get_drvdata(adev);
+	void __iomem *base = isys->pdata->base +
+		isys->pdata->ipdata->hw_variant.spc_offset;
+	u32 status = IPU6_ISYS_SPC_STATUS_START |
+		IPU6_ISYS_SPC_STATUS_RUN |
+		IPU6_ISYS_SPC_STATUS_CTRL_ICACHE_INVALIDATE;
+
+	status |= isys->icache_prefetch ? IPU6_ISYS_SPC_STATUS_ICACHE_PREFETCH : 0;
+	writel(status, base + IPU6_ISYS_REG_SPC_STATUS_CTRL);
+}
+
+static int ipu4p_query_sp(struct ipu6_bus_device *adev)
+{
+	struct ipu6_isys *isys = ipu6_bus_get_drvdata(adev);
+	void __iomem *base = isys->pdata->base +
+		isys->pdata->ipdata->hw_variant.spc_offset;
+	u32 status = readl(base + IPU6_ISYS_REG_SPC_STATUS_CTRL);
+
+	status &= IPU6_ISYS_SPC_STATUS_READY | IPU6_ISYS_SPC_STATUS_START;
+	return status == IPU6_ISYS_SPC_STATUS_READY;
+}
+
+static int ipu4p_fwcom_cfg_init(struct ipu6_isys *isys,
+				struct ipu6_fw_com_cfg *cfg,
+				unsigned int num_streams)
+{
+	struct ipu6_fw_syscom_queue_config *input;
+	struct ipu6_fw_syscom_queue_config *output;
+	struct ipu4p_fw_isys_fw_config *fw_cfg;
+	struct device *dev = &isys->adev->auxdev.dev;
+	unsigned int msg_queues = clamp(num_streams, 1U,
+					IPU4P_ISYS_MAX_STREAMS);
+	unsigned int i;
+
+	fw_cfg = devm_kzalloc(dev, sizeof(*fw_cfg), GFP_KERNEL);
+	if (!fw_cfg)
+		return -ENOMEM;
+
+	fw_cfg->num_send_queues[0] = 1;
+	fw_cfg->num_send_queues[1] = 1;
+	fw_cfg->num_send_queues[2] = msg_queues;
+	fw_cfg->num_recv_queues[0] = 1;
+	fw_cfg->num_recv_queues[1] = 0;
+	fw_cfg->num_recv_queues[2] = 1;
+
+	input = devm_kcalloc(dev, IPU4P_BASE_MSG_SEND_QUEUES + msg_queues,
+				     sizeof(*input), GFP_KERNEL);
+	output = devm_kcalloc(dev, IPU4P_N_MAX_RECV_QUEUES,
+				      sizeof(*output), GFP_KERNEL);
+	if (!input || !output)
+		return -ENOMEM;
+
+	cfg->input = input;
+	cfg->output = output;
+	cfg->num_input_queues = IPU4P_BASE_MSG_SEND_QUEUES + msg_queues;
+	cfg->num_output_queues = IPU4P_N_MAX_RECV_QUEUES;
+
+	for (i = 0; i < msg_queues; i++)
+		fw_cfg->buffer_partition.num_gda_pages[i] =
+			(IPU6_DEVICE_GDA_NR_PAGES * IPU6_DEVICE_GDA_VIRT_FACTOR) /
+			msg_queues;
+
+	input[IPU4P_BASE_PROXY_SEND_QUEUES].token_size =
+		sizeof(struct ipu4p_fw_isys_proxy_send_token);
+	input[IPU4P_BASE_PROXY_SEND_QUEUES].queue_size =
+		IPU4P_ISYS_SIZE_PROXY_SEND_QUEUE;
+	input[IPU4P_BASE_DEV_SEND_QUEUES].token_size =
+		sizeof(struct ipu4p_fw_isys_send_token);
+	input[IPU4P_BASE_DEV_SEND_QUEUES].queue_size =
+		IPU4P_DEV_SEND_QUEUE_SIZE;
+	for (i = 0; i < msg_queues; i++) {
+		input[IPU4P_BASE_MSG_SEND_QUEUES + i].token_size =
+			sizeof(struct ipu4p_fw_isys_send_token);
+		input[IPU4P_BASE_MSG_SEND_QUEUES + i].queue_size =
+			IPU4P_ISYS_SIZE_SEND_QUEUE;
+	}
+
+	output[IPU4P_BASE_PROXY_RECV_QUEUES].token_size =
+		sizeof(struct ipu4p_fw_isys_proxy_recv_token);
+	output[IPU4P_BASE_PROXY_RECV_QUEUES].queue_size =
+		IPU4P_ISYS_SIZE_PROXY_RECV_QUEUE;
+	output[IPU4P_BASE_MSG_RECV_QUEUES].token_size =
+		sizeof(struct ipu4p_fw_isys_recv_token);
+	output[IPU4P_BASE_MSG_RECV_QUEUES].queue_size =
+		IPU4P_ISYS_SIZE_RECV_QUEUE;
+
+	cfg->dmem_addr = isys->pdata->ipdata->hw_variant.dmem_offset;
+	cfg->specific_addr = fw_cfg;
+	cfg->specific_size = sizeof(*fw_cfg);
+	return 0;
+}
+
+static int ipu4p_fw_isys_init(struct ipu6_isys *isys, unsigned int num_streams)
+{
+	struct ipu6_fw_com_cfg cfg = {
+		.cell_start = ipu4p_start_sp,
+		.cell_ready = ipu4p_query_sp,
+		.buttress_boot_offset = SYSCOM_BUTTRESS_FW_PARAMS_ISYS_OFFSET,
+	};
+	struct device *dev = &isys->adev->auxdev.dev;
+	unsigned int retry = IPU4P_ISYS_OPEN_RETRY;
+	int ret;
+
+	ret = ipu4p_fwcom_cfg_init(isys, &cfg, num_streams);
+	if (ret)
+		return ret;
+
+	isys->fwctx = ipu6_fw_com_prepare(&cfg, isys->adev, isys->pdata->base);
+	if (!isys->fwctx)
+		return -EIO;
+
+	ret = ipu6_fw_com_open(isys->fwctx);
+	if (ret)
+		return ret;
+
+	do {
+		usleep_range(400, 500);
+		if (ipu6_fw_com_ready(isys->fwctx))
+			return 0;
+	} while (--retry);
+
+	dev_err(dev, "IPU4P ISYS firmware ready timeout\n");
+	ipu6_fw_com_close(isys->fwctx);
+	return -EIO;
+}
+
+static int ipu4p_fw_isys_close(struct ipu6_isys *isys)
+{
+	unsigned int retry = IPU4P_ISYS_CLOSE_RETRY;
+	unsigned long flags;
+	void *fwctx;
+	int ret;
+
+	spin_lock_irqsave(&isys->power_lock, flags);
+	ret = ipu6_fw_com_close(isys->fwctx);
+	fwctx = isys->fwctx;
+	isys->fwctx = NULL;
+	spin_unlock_irqrestore(&isys->power_lock, flags);
+	if (ret)
+		return ret;
+
+	do {
+		usleep_range(400, 500);
+		ret = ipu6_fw_com_release(fwctx, 0);
+	} while (ret && --retry);
+	if (ret) {
+		spin_lock_irqsave(&isys->power_lock, flags);
+		isys->fwctx = fwctx;
+		spin_unlock_irqrestore(&isys->power_lock, flags);
+	}
+	return ret;
+}
+
+static void ipu4p_fw_isys_cleanup(struct ipu6_isys *isys)
+{
+	if (isys->fwctx)
+		ipu6_fw_com_release(isys->fwctx, 1);
+	isys->fwctx = NULL;
+}
+
+static int ipu4p_send_proxy_token(struct ipu6_isys *isys, unsigned int req_id,
+				  unsigned int index, unsigned int offset, u32 value)
+{
+	struct ipu4p_fw_isys_proxy_send_token *token;
+	struct ipu4p_fw_isys_proxy_recv_token *resp;
+	unsigned int retry = 1000;
+
+	token = ipu6_send_get_token(isys->fwctx, IPU4P_BASE_PROXY_SEND_QUEUES);
+	if (!token)
+		return -EBUSY;
+	token->request_id = req_id;
+	token->region_index = index;
+	token->offset = offset;
+	token->value = value;
+	ipu6_send_put_token(isys->fwctx, IPU4P_BASE_PROXY_SEND_QUEUES);
+
+	do {
+		usleep_range(100, 110);
+		resp = ipu6_recv_get_token(isys->fwctx, IPU4P_BASE_PROXY_RECV_QUEUES);
+		if (!resp)
+			continue;
+		if (resp->proxy_resp_info.request_id != req_id) {
+			ipu6_recv_put_token(isys->fwctx, IPU4P_BASE_PROXY_RECV_QUEUES);
+			return -EIO;
+		}
+		ipu6_recv_put_token(isys->fwctx, IPU4P_BASE_PROXY_RECV_QUEUES);
+		return 0;
+	} while (--retry);
+
+	return -ETIMEDOUT;
+}
+
+static int ipu4p_send_cmd(struct ipu6_isys *isys, unsigned int stream_handle,
+				  void *cpu_mapped_buf, dma_addr_t dma_mapped_buf,
+				  size_t size, u16 send_type)
+{
+	struct ipu4p_fw_isys_send_token *token;
+
+	if (cpu_mapped_buf)
+		clflush_cache_range(cpu_mapped_buf, size);
+	token = ipu6_send_get_token(isys->fwctx,
+				    IPU4P_BASE_MSG_SEND_QUEUES + stream_handle);
+	if (!token)
+		return -EBUSY;
+	token->payload = dma_mapped_buf;
+	token->buf_handle = (uintptr_t)cpu_mapped_buf;
+	token->send_type = send_type;
+	token->stream_id = stream_handle;
+	ipu6_send_put_token(isys->fwctx,
+				   IPU4P_BASE_MSG_SEND_QUEUES + stream_handle);
+	return 0;
+}
+
+static int ipu4p_fw_isys_prepare_stream_cfg(struct ipu6_isys_video *av,
+					    struct isys_fw_msgs *msg)
+{
+	struct ipu4p_fw_isys_stream_cfg *cfg = &msg->ipu4p.stream;
+	struct ipu6_isys_stream *stream = av->stream;
+	struct ipu6_isys_queue *aq;
+
+	cfg->src = stream->stream_source;
+	cfg->vc = stream->vc;
+	list_for_each_entry(aq, &stream->queues, node) {
+		struct ipu6_isys_video *video = ipu6_isys_queue_to_video(aq);
+		const struct ipu6_isys_pixelformat *pfmt =
+			ipu6_isys_get_isys_format(ipu6_isys_get_format(video), 0);
+		struct ipu4p_fw_isys_input_pin_info *input;
+		struct ipu4p_fw_isys_output_pin_info *output;
+		struct media_pad *src_pad = media_pad_remote_pad_first(&video->pad);
+		struct v4l2_subdev *sd = media_entity_to_v4l2_subdev(src_pad->entity);
+		struct v4l2_subdev_state *state =
+			v4l2_subdev_get_locked_active_state(sd);
+		struct v4l2_mbus_framefmt *fmt =
+			v4l2_subdev_state_get_format(state, src_pad->index, 0);
+		unsigned int in = cfg->nof_input_pins++;
+		unsigned int out = cfg->nof_output_pins++;
+
+		input = &cfg->input_pins[in];
+		input->input_res.width = fmt->width;
+		input->input_res.height = fmt->height;
+		input->dt = video->dt;
+		input->bits_per_pix = pfmt->bpp_packed;
+		input->mapped_dt = 0x40;
+		input->mipi_store_mode = pfmt->bpp == pfmt->bpp_packed;
+
+		output = &cfg->output_pins[out];
+		output->input_pin_id = in;
+		output->output_res.width = ipu6_isys_get_frame_width(video);
+		output->output_res.height = ipu6_isys_get_frame_height(video);
+		output->stride = ipu6_isys_get_bytes_per_line(video);
+		output->pt = pfmt->bpp != pfmt->bpp_packed ? 3 : 0;
+		output->ft = pfmt->css_pixelformat;
+		output->send_irq = 1;
+		output->reserve_compression = 0;
+		video->aq.fw_output = out;
+		stream->output_pins_queue[out] = &video->aq;
+	}
+	stream->nr_output_pins = cfg->nof_output_pins;
+	return 0;
+}
+
+static int ipu4p_stream_open(struct ipu6_isys *isys, unsigned int handle,
+				     struct isys_fw_msgs *msg)
+{
+	return ipu4p_send_cmd(isys, handle, &msg->ipu4p.stream, msg->dma_addr,
+				      sizeof(msg->ipu4p.stream), 0);
+}
+
+static int ipu4p_stream_start(struct ipu6_isys *isys, unsigned int handle,
+				      struct isys_fw_msgs *msg, bool capture)
+{
+	if (!capture)
+		return ipu4p_send_cmd(isys, handle, NULL, 0, 0, 1);
+	return ipu4p_send_cmd(isys, handle, &msg->ipu4p.frame, msg->dma_addr,
+				      sizeof(msg->ipu4p.frame), 2);
+}
+
+static int ipu4p_stream_capture(struct ipu6_isys *isys, unsigned int handle,
+					struct isys_fw_msgs *msg)
+{
+	return ipu4p_send_cmd(isys, handle, &msg->ipu4p.frame, msg->dma_addr,
+				      sizeof(msg->ipu4p.frame), 3);
+}
+
+static int ipu4p_stream_flush(struct ipu6_isys *isys, unsigned int handle)
+{
+	return ipu4p_send_cmd(isys, handle, NULL, 0, 0, 5);
+}
+
+static int ipu4p_stream_close(struct ipu6_isys *isys, unsigned int handle)
+{
+	return ipu4p_send_cmd(isys, handle, NULL, 0, 0, 6);
+}
+
+static void ipu4p_prepare_buf_set(struct isys_fw_msgs *msg,
+				  struct ipu6_isys_stream *stream,
+				  struct ipu6_isys_buffer_list *bl)
+{
+	struct ipu4p_fw_isys_frame_buff_set *set = &msg->ipu4p.frame;
+	struct ipu6_isys_buffer *ib;
+
+	WARN_ON(!bl->nbufs);
+	set->send_irq_sof = 1;
+	set->send_resp_sof = 1;
+	set->send_resp_capture_ack = 1;
+	set->send_resp_capture_done = 1;
+	list_for_each_entry(ib, &bl->head, head) {
+		struct vb2_buffer *vb = ipu6_isys_buffer_to_vb2_buffer(ib);
+		struct ipu6_isys_queue *aq = vb2_queue_to_isys_queue(vb->vb2_queue);
+		struct vb2_v4l2_buffer *vvb = to_vb2_v4l2_buffer(vb);
+		struct ipu6_isys_video_buffer *ivb =
+			vb2_buffer_to_ipu6_isys_video_buffer(vvb);
+
+		set->output_pins[aq->fw_output].addr = ivb->dma_addr;
+		set->output_pins[aq->fw_output].out_buf_id = vb->index + 1;
+	}
+}
+
+static void ipu4p_dump_stream_cfg(struct device *dev, struct isys_fw_msgs *msg)
+{
+	dev_dbg(dev, "IPU4P ISYS stream: %u input pins, %u output pins\n",
+		msg->ipu4p.stream.nof_input_pins,
+		msg->ipu4p.stream.nof_output_pins);
+}
+
+static void ipu4p_dump_frame_buf_set(struct device *dev,
+				     struct isys_fw_msgs *msg, unsigned int outputs)
+{
+	dev_dbg(dev, "IPU4P ISYS frame buffer set: %u outputs\n", outputs);
+}
+
+int ipu4p_isys_isr_one(struct ipu6_bus_device *adev)
+{
+	struct ipu6_isys *isys = ipu6_bus_get_drvdata(adev);
+	struct ipu4p_fw_isys_recv_token *token;
+	struct ipu4p_fw_isys_resp_info *resp;
+	struct ipu6_isys_stream *stream;
+	struct isys_fw_msgs *msg;
+	u64 ts;
+
+	if (!isys->fwctx)
+		return 1;
+	token = ipu6_recv_get_token(isys->fwctx, IPU4P_BASE_MSG_RECV_QUEUES);
+	if (!token)
+		return 1;
+	resp = &token->resp_info;
+	ts = ((u64)resp->timestamp[1] << 32) | resp->timestamp[0];
+	if (resp->stream_handle >= IPU4P_ISYS_MAX_STREAMS)
+		goto put;
+	stream = ipu6_isys_query_stream_by_handle(isys, resp->stream_handle);
+	if (!stream)
+		goto put;
+	stream->error = resp->error_info.error;
+	switch (resp->type) {
+	case 0:
+		complete(&stream->stream_open_completion);
+		break;
+	case 7:
+		msg = container_of((void *)(uintptr_t)resp->buf_id,
+				   struct isys_fw_msgs, dummy);
+		ipu6_put_fw_msg_buf(isys, msg);
+		if (resp->pin_id < IPU4P_MAX_OPINS)
+			ipu6_stream_buf_ready(stream, resp->pin_id, resp->pin.addr,
+					      ts, true);
+		break;
+	case 1:
+		complete(&stream->stream_start_completion);
+		break;
+	case 2:
+		complete(&stream->stream_start_completion);
+		break;
+	case 4:
+	case 5:
+		complete(&stream->stream_stop_completion);
+		break;
+	case 6:
+		complete(&stream->stream_close_completion);
+		break;
+	case 9:
+		ipu6_isys_csi2_sof_event_by_stream(stream);
+		break;
+	case 10:
+		ipu6_isys_csi2_eof_event_by_stream(stream);
+		break;
+	}
+	ipu6_isys_put_stream(stream);
+put:
+	ipu6_recv_put_token(isys->fwctx, IPU4P_BASE_MSG_RECV_QUEUES);
+	return 0;
+}
+
+const struct ipu6_fw_isys_ops ipu4p_fw_isys_ops = {
+	.isr_one = ipu4p_isys_isr_one,
+	.init = ipu4p_fw_isys_init,
+	.close = ipu4p_fw_isys_close,
+	.cleanup = ipu4p_fw_isys_cleanup,
+	.send_cmd = ipu4p_send_cmd,
+	.prepare_stream_cfg = ipu4p_fw_isys_prepare_stream_cfg,
+	.prepare_buf_set = ipu4p_prepare_buf_set,
+	.stream_open = ipu4p_stream_open,
+	.stream_start = ipu4p_stream_start,
+	.stream_capture = ipu4p_stream_capture,
+	.stream_flush = ipu4p_stream_flush,
+	.stream_close = ipu4p_stream_close,
+	.dump_stream_cfg = ipu4p_dump_stream_cfg,
+	.dump_frame_buf_set = ipu4p_dump_frame_buf_set,
+};
diff --git a/drivers/media/pci/intel/ipu6/ipu4p-fw-isys.h b/drivers/media/pci/intel/ipu6/ipu4p-fw-isys.h
new file mode 100644
index 000000000..4c19967ca
--- /dev/null
+++ b/drivers/media/pci/intel/ipu6/ipu4p-fw-isys.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (C) 2026 Intel Corporation */
+
+#ifndef IPU4P_FW_ISYS_H
+#define IPU4P_FW_ISYS_H
+
+#include <linux/types.h>
+
+struct ipu6_bus_device;
+struct ipu6_fw_isys_ops;
+struct ipu6_isys;
+struct ipu6_isys_video;
+struct ipu6_isys_stream;
+struct ipu6_isys_buffer_list;
+struct isys_fw_msgs;
+
+#define IPU4P_ISYS_MAX_STREAMS		8U
+#define IPU4P_MAX_IPINS			4U
+#define IPU4P_MAX_OPINS			6U
+#define IPU4P_NOF_SRAM_BLOCKS_MAX	8U
+#define IPU4P_DEV_SEND_QUEUE_SIZE	8U
+#define IPU4P_ISYS_SIZE_RECV_QUEUE	40U
+#define IPU4P_ISYS_SIZE_SEND_QUEUE	40U
+#define IPU4P_ISYS_SIZE_PROXY_RECV_QUEUE	5U
+#define IPU4P_ISYS_SIZE_PROXY_SEND_QUEUE	5U
+#define IPU4P_ISYS_NUM_RECV_QUEUE	1U
+#define IPU4P_PIN_PLANES_MAX		4U
+#define IPU4P_ISYS_OPEN_RETRY		2000
+#define IPU4P_ISYS_CLOSE_RETRY		2000
+
