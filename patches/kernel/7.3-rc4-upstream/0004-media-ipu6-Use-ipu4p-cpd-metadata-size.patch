From 269f276758dd83e94198ce59aed3d9497bd21ee3 Mon Sep 17 00:00:00 2001
From: Ruslan Bay <67730802+ruslanbay@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:59:03 +0000
Subject: [PATCH 04/10] media: ipu6: Use ipu4p cpd metadata size

Use the 32-byte component hash size for IPU4P firmware metadata,
matching IPU6SE and ensuring CPD metadata entries are parsed correctly.
---
 drivers/media/pci/intel/ipu6/ipu6.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/media/pci/intel/ipu6/ipu6.c b/drivers/media/pci/intel/ipu6/ipu6.c
index aa2bfe9e0..789477e38 100644
--- a/drivers/media/pci/intel/ipu6/ipu6.c
+++ b/drivers/media/pci/intel/ipu6/ipu6.c
@@ -665,6 +665,8 @@ static int ipu6_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	case PCI_DEVICE_ID_INTEL_IPU4P:
 		isp->hw_ver = IPU_VERSION_4P;
 		isp->cpd_fw_name = IPU4P_FIRMWARE_NAME;
+		isp->cpd_metadata_cmpnt_size =
+			sizeof(struct ipu6se_cpd_metadata_cmpnt);
 		isp->buttress.regs = &ipu6_buttress_regs;
 		isys_ctrl = &ipu4p_isys_buttress_ctrl;
 		psys_ctrl = &ipu4p_psys_buttress_ctrl;
-- 
